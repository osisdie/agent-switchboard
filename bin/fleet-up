#!/usr/bin/env bash
# fleet-up — start the Claude Code fleet in tmux (idempotent).
#
# Usage: fleet-up [--dry-run] [--only CODE]
#
# Reads fleet.yaml from the config dir. For every session with `autostart: true` that has no
# tmux session yet, creates `tmux new-session -d -s CODE -c CWD` and types (into the pane's
# POSIX shell):
#   t0=$(date +%s); claude -n CODE --remote-control CODE -r RESUME EXTRA;
#   [ $(( $(date +%s) - t0 )) -lt 15 ] && claude -n CODE --remote-control CODE EXTRA
# i.e. a fresh session is started only when the resume attempt ends within
# resume_fallback_seconds (default 15: "no such session"), never after a real session exits.
# Without resume_name, or with `resume: false`, it starts fresh:
#   claude -n CODE --remote-control CODE EXTRA ['INITIAL_PROMPT']
# `initial_prompt` is single-line (newlines become spaces, since the command is typed into the
# pane) and single-quoted for the shell; it is also used when a resume falls back to fresh.
# With `collector: true` (default) it also makes sure a tmux session `switchboard` runs
# board-collect, after `board-collect --baseline` when $BOARD_HOME/alerts.json does not exist
# yet (no alert storm for conditions already open).
#
# Only one fleet-up runs at a time ($BOARD_HOME/fleet-up.lock); a second one exits 0 at once,
# silently, so it is safe to call from a shell rc file, systemd and a logon task together.
#
#   --dry-run    print what would be done, change nothing
#   --only CODE  start just this session (even if autostart is false)
#
# Log: $BOARD_HOME/fleet-up.log
set -u

REPO="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
BOARD_HOME="${BOARD_HOME:-$HOME/.agent-switchboard}"
export BOARD_HOME
FLEET="$REPO/lib/fleet.py"

dry=0; only=""
while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run|-n) dry=1 ;;
    --only) shift; only="${1:-}" ;;
    -h|--help) awk 'NR > 1 && !/^#/ { exit } NR > 1 && !/shellcheck/ { sub(/^# ?/, ""); print }' "$0"; exit 0 ;;
    *) echo "fleet-up: unknown argument: $1" >&2; exit 2 ;;
  esac
  shift
done

# Private BOARD_HOME, without changing the umask that tmux (and every pane) inherits from us.
[ -d "$BOARD_HOME" ] || (umask 077; mkdir -p "$BOARD_HOME" && chmod 700 "$BOARD_HOME")
LOG="$BOARD_HOME/fleet-up.log"
[ "$dry" = 1 ] || [ -e "$LOG" ] || (umask 077; : >> "$LOG")
log() { local m; m="$(date '+%F %T') $*"; echo "$m"; [ "$dry" = 1 ] || echo "$m" >> "$LOG"; }
# Children must not inherit the lock fd (8): the tmux server started by the first new-session
# would otherwise hold the lock for as long as it lives.
run() { if [ "$dry" = 1 ]; then echo "  would run: $*"; else "$@" 8>&-; fi; }

for c in tmux python3 jq; do
  command -v "$c" >/dev/null 2>&1 || { log "fleet-up: $c not found"; exit 1; }
done

# systemd (at distro boot), a logon task and shell rc files may all run fleet-up at once.
# Non-blocking: if another run holds the lock, it is doing the same work, so just leave.
if [ "$dry" = 0 ]; then
  exec 8>>"$BOARD_HOME/fleet-up.lock"
  flock -n 8 || exit 0
fi

log "fleet-up start (config: $(python3 "$FLEET" config-dir))"

claude_bin="${CLAUDE_BIN:-claude}"
# POSIX single-quoting (the pane's shell may not be bash, so no $'...' from printf %q).
sq() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }
fallback_s="$(python3 "$FLEET" get resume_fallback_seconds 15)"
case "$fallback_s" in ''|*[!0-9]*) fallback_s=15 ;; esac
started=0
while IFS= read -r line; do
  [ -n "$line" ] || continue
  code="$(jq -r '.code' <<<"$line")"
  cwd="$(jq -r '.cwd // empty' <<<"$line")"
  auto="$(jq -r '.autostart' <<<"$line")"
  resume="$(jq -r '.resume_name // empty' <<<"$line")"
  [ "$(jq -r '.resume' <<<"$line")" = false ] && resume=""
  extra="$(jq -r '.extra_args // ""' <<<"$line")"
  prompt="$(jq -r '.initial_prompt // ""' <<<"$line" | tr '\r\n' '  ')"
  prompt="${prompt% }"
  if [ -n "$only" ]; then
    [ "$code" = "$only" ] || continue
  else
    [ "$auto" = true ] || continue
  fi
  if tmux has-session -t "=$code" 2>/dev/null 8>&-; then
    log "$code: tmux session exists — skip"
    continue
  fi
  [ -n "$cwd" ] && [ -d "$cwd" ] || { log "$code: cwd '$cwd' missing — skip"; continue; }

  q_code="$(printf '%q' "$code")"
  base="$claude_bin -n $q_code --remote-control $q_code"
  [ -n "$extra" ] && base_extra="$base $extra" || base_extra="$base"
  fresh="$base_extra"
  [ -n "$prompt" ] && fresh="$fresh $(sq "$prompt")"
  if [ -n "$resume" ]; then
    # shellcheck disable=SC2016  # expanded by the pane's shell, not here
    cmd='_fleet_t0=$(date +%s); '"$base -r $(sq "$resume")${extra:+ $extra}"'; [ $(( $(date +%s) - _fleet_t0 )) -lt '"$fallback_s"' ] && '"$fresh"
  else
    cmd="$fresh"
  fi
  log "$code: starting in $cwd: $cmd"
  # A concurrent creator (e.g. another fleet-up) wins the race: never type into its pane.
  run tmux new-session -d -s "$code" -c "$cwd" || { log "$code: tmux new-session failed — skip"; continue; }
  run tmux send-keys -t "=$code:" -l "$cmd"
  run tmux send-keys -t "=$code:" Enter
  started=$((started + 1))
done < <(python3 "$FLEET" sessions)

if [ -z "$only" ] && [ "$(python3 "$FLEET" get collector true)" = true ]; then
  # First start on this BOARD_HOME: ack whatever is already open, so only new conditions alert.
  if [ ! -f "$BOARD_HOME/alerts.json" ]; then
    log "alerts: no alerts.json yet — taking a baseline"
    if [ "$dry" = 1 ]; then
      echo "  would run: $REPO/bin/board-collect --baseline"
    else
      "$REPO/bin/board-collect" --baseline >> "$LOG" 2>&1 8>&- || log "alerts: baseline failed (collector will retry)"
    fi
  fi
  collector_running=0
  if [ -f "$BOARD_HOME/collect.lock" ] && ! flock -n "$BOARD_HOME/collect.lock" true 2>/dev/null; then
    collector_running=1
  fi
  if [ "$collector_running" = 1 ]; then
    log "collector: already running"
  else
    collect_cmd="BOARD_HOME=$(printf '%q' "$BOARD_HOME")"
    [ -n "${BOARD_CONFIG_DIR:-}" ] && collect_cmd="$collect_cmd BOARD_CONFIG_DIR=$(printf '%q' "$BOARD_CONFIG_DIR")"
    collect_cmd="$collect_cmd $(printf '%q' "$REPO/bin/board-collect")"
    if tmux has-session -t "=switchboard" 2>/dev/null 8>&-; then
      log "collector: starting in new window of tmux session switchboard"
      run tmux new-window -t "=switchboard:" -n collector "$collect_cmd"
    else
      log "collector: starting tmux session switchboard"
      run tmux new-session -d -s switchboard -n collector "$collect_cmd"
    fi
  fi
fi

log "fleet-up done ($started session(s) started)"
exit 0
