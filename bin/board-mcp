#!/usr/bin/env python3
"""board-mcp: the board's MCP server over stdio, for Claude Code, Claude Desktop or any MCP client.

A thin client of the board's /api/v1 (lib/mcp_tools.py; docs/contract.md "MCP"). Configured by env:
  BOARD_API_KEY            required, even locally: a board API key (`board apikey create`)
  BOARD_API_URL            default http://127.0.0.1:39410 (https unless loopback)
  CF_ACCESS_CLIENT_ID      optional, both or neither: a Cloudflare Access service token, for a
  CF_ACCESS_CLIENT_SECRET  board behind Access (see README, "Connect an MCP client")
Reads JSON-RPC on stdin, one message per line, and answers on stdout; diagnostics go to stderr.
The key and the Access secret are never printed.
"""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib"))
import mcp_tools  # noqa: E402

if __name__ == "__main__":
    sys.exit(mcp_tools.main(doc=__doc__))
