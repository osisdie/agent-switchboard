#!/usr/bin/env bash
# shellcheck disable=SC2016  # jq programs are single-quoted on purpose
# board — agent-switchboard command line.
#
# Usage:
#   board ls [--refresh]                       table of sessions from snapshot.json
#   board snapshot [--refresh]                 print snapshot.json
#   board ask --from CODE "question" [--option X]... [--context T]
#             [--task ID] [--stage S] [--gate G] [--artifact REF]
#                                              create a question (or gate) decision, print its id
#   board decisions [--status S] [--json]      list decisions
#   board answer ID ANSWER --by WHO            mark a decision answered (mirrors the board db);
#                                              WHO must be in approvers (release_managers for
#                                              gate:production), else it is marked unauthorized
#   board mark ID relayed|stale|timeout|unauthorized
#                                              set a decision's status
#   board task new --owner CODE "title" [--stage S]   create a task, print its id
#   board task stage ID STAGE [--artifact key=ref]... move a task to a stage
#   board task ls [--json] | board task show ID
#                                              stages: plan design build test deploy production
#                                              maintain; artifacts: intent spec plan evals review
#   board limit [--json|--clear]               show (or end) the current usage-limit episode
#   board press CODE allow|deny --expect TOOL_USE_ID [--allow-truncated]
#                                              answer a permission prompt via tmux: needs an
#                                              approver's matching `board answer`, then checks
#   board notify "text"                        send a Slack message (SLACK_WEBHOOK_URL)
#   board ack KEY [KEY...]                     acknowledge alerts (board-notify ack; glob ok)
#   board away on --by WHO --said "owner's words" [--replace]
#   board away off --by WHO [--said "..."]     owner-away mode ($BOARD_HOME/owner-away)
#   board away status [--quiet|--json]         exit 0 when the owner is away, 1 when not
#   board consensus propose --from CODE --to A,B[,..] [--ref REF] "proposal"
#   board consensus vote ID agree|object --from CODE [--note T]
#   board consensus ls [--all] | show ID [--markdown]
#                                              decide among sessions while the owner is away
#                                              (never for red lines, never for board asks)
#   board doctor                               check dependencies and installation
#
# Env: BOARD_HOME (default ~/.agent-switchboard), BOARD_CONFIG_DIR (default <repo>/tmp-local
#      if it exists, else ~/.config/agent-switchboard), CLAUDE_SESSIONS_DIR, CLAUDE_SETTINGS.
#
# Exit codes: 0 ok, 1 error (`away status`: the owner is not away), 2 usage (also an unknown
#             option to `away status`), 3 press refused: screen/state mismatch (no keys sent),
#             4 refused: not authorized (answer: not an approver; press: no approver's answer;
#             consensus: not a participant, or --from is not this tmux session).
set -u

REPO="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
BOARD_HOME="${BOARD_HOME:-$HOME/.agent-switchboard}"
export BOARD_HOME
FLEET="$REPO/lib/fleet.py"
umask 077   # everything under BOARD_HOME is private to this user
[ -d "$BOARD_HOME" ] || { mkdir -p "$BOARD_HOME" && chmod 700 "$BOARD_HOME"; } 2>/dev/null

die() { echo "board: $*" >&2; exit 1; }
usage() { awk 'NR > 1 && !/^#/ { exit } NR > 1 && !/shellcheck/ { sub(/^# ?/, ""); print }' "$0"; }
need_jq() { command -v jq >/dev/null 2>&1 || die "jq is required"; }

now_ms() { local t="${EPOCHREALTIME/./}"; echo $(( t / 1000 )); }

config_dir() { python3 "$FLEET" config-dir; }
cfg_get() { python3 "$FLEET" get "$@"; }

log_event() {  # log_event JSON
  mkdir -p "$BOARD_HOME"
  printf '%s\n' "$1" >> "$BOARD_HOME/events.jsonl"
}

write_atomic() {  # write_atomic PATH CONTENT
  local tmp="$1.tmp.$$"
  printf '%s\n' "$2" > "$tmp" && mv -f "$tmp" "$1"
}

dec_path() {
  case "$1" in ''|*[!A-Za-z0-9._-]*) die "invalid decision id: $1" ;; esac
  echo "$BOARD_HOME/decisions/$1.json"
}

refresh() { "$REPO/bin/board-collect" --once --no-notify >/dev/null || true; }

snapshot_file() {
  local f="$BOARD_HOME/snapshot.json"
  [ -f "$f" ] || refresh
  [ -f "$f" ] || die "no snapshot at $f (is board-collect running?)"
  echo "$f"
}

# Table cells: control characters (terminal escapes, CR, ...) become "?".
JQ_SAFE='def safe: tostring | gsub("[\u0000-\u001f\u007f-\u009f]"; "?");'

# ---------------------------------------------------------------- per-command help
sub_usage() {  # sub_usage COMMAND [SUBCOMMAND]
  case "$1${2:+ $2}" in
    ls) echo "usage: board ls [--refresh]"
        echo "  table of sessions (code, state, status, age, task stage, pending tool) from snapshot.json" ;;
    snapshot) echo "usage: board snapshot [--refresh]"
        echo "  print snapshot.json (--refresh rebuilds it first)" ;;
    ask) echo "usage: board ask --from CODE \"question\" [--option X]... [--context T]"
        echo "                 [--task ID] [--stage S] [--gate G] [--artifact REF]"
        echo "  create a decision and print its id. With --task/--gate it is a gate decision"
        echo "  (defaults: stage = the task's stage, gate = owner, options = approve / request changes)."
        echo "  stages: $STAGES" ;;
    decisions) echo "usage: board decisions [--status pending|answered|relayed|stale|timeout|unauthorized] [--json]" ;;
    answer) echo "usage: board answer ID ANSWER --by WHO"
        echo "  mark a decision answered. WHO must be in approvers (production gate or stage:"
        echo "  release_managers, falling back to approvers). Otherwise the decision is marked"
        echo "  unauthorized and the command exits 4. No approvers configured = refused (fails closed)."
        echo "  For a gate decision, these answers count as approved (case-insensitive, whole answer):"
        local w out=""
        for w in "${APPROVE_WORDS[@]}"; do out="${out:+$out, }$w"; done
        echo "    $out"
        echo "  anything else (e.g. \"request changes\") records the gate as rejected." ;;
    mark) echo "usage: board mark ID relayed|stale|timeout|unauthorized" ;;
    press) echo "usage: board press CODE allow|deny --expect TOOL_USE_ID [--allow-truncated]"
        echo "  send the allow/deny keys to CODE's tmux pane. Exit 4 (nothing sent) unless the local"
        echo "  permission decision is answered with this action by an approver (board answer), and"
        echo "  its summary is complete (or --allow-truncated). Exit 3 (nothing sent, decision marked"
        echo "  stale) unless the hook state still shows that tool_use_id pending, the pane shows a"
        echo "  permission prompt and the start of the pending input is visible in the pane." ;;
    task) echo "usage: board task new|stage|ls|show ..."
        echo "  board task new --owner CODE \"title\" [--stage S]"
        echo "  board task stage ID STAGE [--artifact key=ref]..."
        echo "  board task ls [--json]"
        echo "  board task show ID"
        echo "  stages: $STAGES; artifact keys: $ARTIFACT_KEYS" ;;
    "task new") echo "usage: board task new --owner CODE \"title\" [--stage S]   (prints the task id)" ;;
    "task stage") echo "usage: board task stage ID STAGE [--artifact key=ref]..."
        echo "  stages: $STAGES; artifact keys: $ARTIFACT_KEYS" ;;
    "task ls") echo "usage: board task ls [--json]" ;;
    "task show") echo "usage: board task show ID" ;;
    limit) echo "usage: board limit [--json|--clear]"
        echo "  show (or end) the current usage-limit episode (\$BOARD_HOME/limit.json)" ;;
    ack) echo "usage: board ack KEY [KEY...]"
        echo "  stop escalation of open alerts (board-notify ack). KEY may be a glob: 'session:API:*'" ;;
    notify) echo "usage: board notify [--link ID|root] \"text\""
        echo "  post to SLACK_WEBHOOK_URL (env or <config dir>/.env); silent no-op when unset"
        echo "  --link appends the board link (BOARD_PUBLIC_URL / fleet.yaml board_url) that opens"
        echo "  decision, message or consensus ID, or the board root; nothing when no board URL is set" ;;
    doctor) echo "usage: board doctor"
        echo "  check dependencies, config, hook installation and the collector" ;;
    away) echo "usage: board away on --by WHO --said \"owner's words\" [--replace]"
        echo "       board away off --by WHO [--said \"...\"]"
        echo "       board away status [--quiet|--json]"
        echo "  owner-away mode. The owner is away while \$BOARD_HOME/owner-away exists, whatever its"
        echo "  content. Only a session that got the owner's own instruction turns it on or off."
        echo "  on: records {since, by, said}; when already away it shows the record and keeps it"
        echo "  (unless --replace). off: removes it; pending consensus items go back to the owner."
        echo "  status: exit 0 when away, 1 when not (--quiet prints nothing, --json the record);"
        echo "  2 for a usage error, so a typo never reads as \"not away\"." ;;
    "away on") echo "usage: board away on --by WHO --said \"owner's words\" [--replace]" ;;
    "away off") echo "usage: board away off --by WHO [--said \"...\"]" ;;
    "away status") echo "usage: board away status [--quiet|--json]   (exit 0 = away, 1 = not away, 2 = usage)" ;;
    consensus) echo "usage: board consensus propose --from CODE --to A,B[,..] [--ref REF] \"proposal\""
        echo "       board consensus vote ID agree|object --from CODE [--note T]"
        echo "       board consensus ls [--all]"
        echo "       board consensus show ID [--markdown]"
        echo "  while the owner is away, sessions decide cross-session questions by explicit consensus:"
        echo "  every participant must vote agree (the proposer counts as agreeing); silence is not"
        echo "  agreement; one objection parks the item for the owner. When the owner comes back"
        echo "  (board away off) pending items become owner_back. A vote may change agree -> object,"
        echo "  never object -> agree. Consensus never answers a board ask."
        echo "  Votes are self-attested: --from is declared by the caller, not verified. Each session"
        echo "  votes only as itself. Inside tmux, a --from that is not this tmux session is refused (exit 4)."
        red_lines_text | sed 's/^/  /' ;;
    "consensus propose") echo "usage: board consensus propose --from CODE --to A,B[,..] [--ref REF] \"proposal\"   (prints the id)" ;;
    "consensus vote") echo "usage: board consensus vote ID agree|object --from CODE [--note T]" ;;
    "consensus ls") echo "usage: board consensus ls [--all]   (default: pending, plus anything decided in the last 24 h)" ;;
    "consensus show") echo "usage: board consensus show ID [--markdown]   (--markdown: a block to paste into the PR/ticket)" ;;
    *) usage ;;
  esac
}

wants_help() {  # true when any argument is -h/--help
  local a
  for a in "$@"; do case "$a" in -h|--help) return 0 ;; esac; done
  return 1
}

# ---------------------------------------------------------------- ls / snapshot
cmd_ls() {
  need_jq
  [ "${1:-}" = "--refresh" ] && refresh
  local f; f="$(snapshot_file)" || exit 1
  local now; now="$(now_ms)"
  {
    printf 'CODE\tSTATE\tSTATUS\tAGE\tSTAGE\tPENDING\tREMOTE\tCWD\n'
    jq -r --argjson now "$now" "$JQ_SAFE"'
      def age: if (. // 0) == 0 then "-" else (($now - .) / 1000 | floor) as $s
        | if $s < 60 then "\($s)s" elif $s < 3600 then "\($s/60|floor)m"
          elif $s < 86400 then "\($s/3600|floor)h" else "\($s/86400|floor)d" end end;
      .sessions[] | [ .code, .state, (.status // "-"), (.updated_at | age), (.stage // "-"),
        (if .pending then ((.pending.tool_name // "?") + ": " + ((.pending.summary // "") | gsub("[\t\n]"; " ") | .[0:40])) else "-" end),
        (if .remote_url then "yes" else "-" end), (.cwd // "-") ] | map(safe) | @tsv' "$f"
  } | column -t -s $'\t'
  local n; n="$(jq '[.decisions[] | select(.status == "pending")] | length' "$f")"
  [ "$n" -gt 0 ] && echo && echo "$n pending decision(s) — see: board decisions --status pending"
  if [ "$(jq '.limit != null' "$f")" = true ]; then
    echo; echo "USAGE LIMIT ACTIVE — $(python3 "$REPO/lib/limit.py" show | head -1)"
  fi
  return 0
}

cmd_snapshot() {
  [ "${1:-}" = "--refresh" ] && refresh
  cat "$(snapshot_file)"
}

# ---------------------------------------------------------------- decisions
STAGES="plan design build test deploy production maintain"
ARTIFACT_KEYS="intent spec plan evals review"
# Gate answers that count as "approved" (case-insensitive, whole answer). Single source for both
# the matcher below and `board answer --help`.
APPROVE_WORDS=(approve approved yes y allow ok lgtm go ship "ship it")
approve_re() { local IFS='|'; printf '^[[:space:]]*(%s)[[:space:]]*$' "${APPROVE_WORDS[*]}"; }

valid_stage() { case " $STAGES " in *" $1 "*) return 0 ;; esac; return 1; }

task_path() {
  case "$1" in ''|*[!A-Za-z0-9._-]*) die "invalid task id: $1" ;; esac
  echo "$BOARD_HOME/tasks/$1.json"
}

new_id() {  # new_id PREFIX NOW_MS
  printf '%s-%s-%04x%04x\n' "$1" "$(( $2 / 1000 ))" "$RANDOM" "$RANDOM"
}

cmd_ask() {
  need_jq
  local from="" question="" context="" task="" stage="" gate="" artifact="" opts=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --from) shift; from="${1:-}" ;;
      --option) shift; opts+=("${1:-}") ;;
      --context) shift; context="${1:-}" ;;
      --task) shift; task="${1:-}" ;;
      --stage) shift; stage="${1:-}" ;;
      --gate) shift; gate="${1:-}" ;;
      --artifact) shift; artifact="${1:-}" ;;
      -*) die "ask: unknown option $1" ;;
      *) [ -z "$question" ] || die "ask: only one question"; question="$1" ;;
    esac
    shift
  done
  [ -n "$from" ] && [ -n "$question" ] || {
    sub_usage ask >&2
    exit 2
  }
  [ -z "$stage" ] || valid_stage "$stage" || die "ask: unknown stage '$stage' (one of: $STAGES)"
  local tf=""
  if [ -n "$task" ]; then
    tf="$(task_path "$task")"
    [ -f "$tf" ] || die "ask: no such task: $task"
    [ -n "$stage" ] || stage="$(jq -r '.stage // empty' "$tf")"
    [ -n "$gate" ] || gate="owner"
  fi
  local now id opts_json
  now="$(now_ms)"
  id="$(new_id d "$now")"
  if [ ${#opts[@]} -gt 0 ]; then
    opts_json="$(printf '%s\n' "${opts[@]}" | jq -R . | jq -sc .)"
  elif [ -n "$gate" ]; then
    opts_json='["approve","request changes"]'
  else
    opts_json="[]"
  fi
  mkdir -p "$BOARD_HOME/decisions"
  write_atomic "$(dec_path "$id")" "$(jq -n --arg id "$id" --arg from "$from" --arg q "$question" \
    --arg ctx "$context" --argjson opts "$opts_json" --argjson now "$now" \
    --arg task "$task" --arg stage "$stage" --arg gate "$gate" --arg art "$artifact" '
    def nz: if . == "" then null else . end;
    { id: $id, kind: "question", from: $from, question: $q, options: $opts,
      context: ($ctx | nz),
      status: "pending", answer: null, answered_by: null, answered_at: null, relayed_at: null,
      created_at: $now }
    + (if $task != "" or $gate != "" or $stage != "" then
         { task_id: ($task | nz), stage: ($stage | nz), gate: ($gate | nz), artifact_ref: ($art | nz) }
       else {} end)')"
  if [ -n "$tf" ]; then
    write_atomic "$tf" "$(jq --arg id "$id" --arg stage "$stage" --arg gate "$gate" --argjson now "$now" '
      .gates = ((.gates // []) + [{ stage: $stage, gate: $gate, status: "pending", decision_id: $id,
                                    approved_by: null, approved_at: null }])
      | .updated_at = $now' "$tf")"
  fi
  log_event "$(jq -cn --arg id "$id" --arg from "$from" --arg task "$task" --arg gate "$gate" --argjson now "$now" \
    '{ts: $now, type: "ask", id: $id, from: $from} + (if $task == "" then {} else {task_id: $task} end)
     + (if $gate == "" then {} else {gate: $gate} end)')"
  echo "$id"
}

cmd_decisions() {
  need_jq
  local status="" json=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --status) shift; status="${1:-}" ;;
      --json) json=1 ;;
      *) die "decisions: unknown option $1" ;;
    esac
    shift
  done
  local files=("$BOARD_HOME"/decisions/*.json)
  [ -e "${files[0]}" ] || { [ "$json" = 1 ] && echo "[]"; return 0; }
  local all
  all="$(jq -s --arg s "$status" '[ .[] | select($s == "" or .status == $s) ] | sort_by(.created_at)' "${files[@]}")"
  if [ "$json" = 1 ]; then echo "$all"; return 0; fi
  {
    printf 'ID\tKIND\tFROM\tSTATUS\tGATE\tANSWER\tQUESTION\n'
    jq -r "$JQ_SAFE"'.[] | [ .id, .kind, (.from // "-"), .status,
      (if .gate then ((.stage // "?") + "/" + .gate) else "-" end), (.answer // "-"),
      ((if .kind == "permission" then ((.tool_name // "?") + ": " + (.summary // "")) else .question end)
        | gsub("[\t\n]"; " ") | .[0:60]) ] | map(safe) | @tsv' <<<"$all"
  } | column -t -s $'\t'
}

update_decision() {  # update_decision ID JQ_FILTER [jq args...]
  local id="$1" filter="$2"; shift 2
  local f; f="$(dec_path "$id")"
  [ -f "$f" ] || die "no such decision: $id"
  local out
  out="$(jq "$@" "$filter" "$f")" || die "failed to update $id"
  write_atomic "$f" "$out"
}

# A decision is a production decision when its gate or its stage, trimmed and lowercased, is
# "production" (the same rule as lib/notify.py and lib/collect.py).
is_production() {  # is_production DECISION_FILE
  [ "$(jq -r '[.gate, .stage] | map((. // "") | tostring | ascii_downcase | gsub("^\\s+|\\s+$"; ""))
               | any(. == "production")' "$1")" = true ]
}

# Prints the ids allowed to answer decision file $1, one per line.
# Fails closed: exit 1 when nobody is configured (no approvers; for production no
# release_managers and no approvers).
allowed_ids() {
  local list
  if is_production "$1"; then
    list="$(cfg_get release_managers)"
    [ "$(jq 'length' <<<"${list:-[]}")" -gt 0 ] || list="$(cfg_get approvers)"
  else
    list="$(cfg_get approvers)"
  fi
  [ "$(jq 'length' <<<"${list:-[]}")" -gt 0 ] || return 1
  jq -r '.[]? | tostring' <<<"${list:-[]}"
}

# allowed_by DECISION_FILE WHO → 0 when WHO may answer it.
allowed_by() {
  local allowed
  allowed="$(allowed_ids "$1")" || return 1
  grep -qxF -- "$2" <<<"$allowed"
}

cmd_answer() {
  need_jq
  local id="${1:-}" answer="${2:-}" by=""
  if [ $# -ge 2 ]; then shift 2; else set --; fi
  while [ $# -gt 0 ]; do
    case "$1" in
      --by) shift; by="${1:-}" ;;
      *) die "answer: unknown option $1" ;;
    esac
    shift
  done
  [ -n "$id" ] && [ -n "$answer" ] && [ -n "$by" ] || { sub_usage answer >&2; exit 2; }
  local f; f="$(dec_path "$id")"
  [ -f "$f" ] || die "no such decision: $id"
  local cur; cur="$(jq -r '.status' "$f")"
  case "$cur" in
    pending|answered|unauthorized) ;;
    *) die "decision $id is already $cur" ;;
  esac
  local now; now="$(now_ms)"

  local allowed
  if ! allowed="$(allowed_ids "$f")"; then
    log_event "$(jq -cn --arg id "$id" --arg by "$by" --argjson now "$now" \
      '{ts: $now, type: "unauthorized", id: $id, by: $by, reason: "no approvers configured"}')"
    if is_production "$f"; then
      echo "board answer: refused — production needs release_managers (or approvers) in fleet.yaml; left pending" >&2
    else
      echo "board answer: refused — no approvers in fleet.yaml (fails closed); left pending" >&2
    fi
    exit 4
  fi
  if ! grep -qxF -- "$by" <<<"$allowed"; then
    # Never let a refused answer cancel an approver's answer that is waiting to be relayed.
    if [ "$cur" = answered ]; then
      log_event "$(jq -cn --arg id "$id" --arg by "$by" --argjson now "$now" \
        '{ts: $now, type: "unauthorized", id: $id, by: $by, reason: "already answered by an approver; left as is"}')"
      echo "board answer: refused — $by may not answer $id; it keeps its approver's answer" >&2
      exit 4
    fi
    update_decision "$id" '.status = "unauthorized" | .answer = $a | .answered_by = $by | .answered_at = $now | .updated_at = $now' \
      --arg a "$answer" --arg by "$by" --argjson now "$now"
    log_event "$(jq -cn --arg id "$id" --arg by "$by" --argjson now "$now" '{ts: $now, type: "unauthorized", id: $id, by: $by}')"
    echo "board answer: refused — $by may not answer $id (not in $(if is_production "$f"; then echo release_managers/approvers; else echo approvers; fi)); marked unauthorized" >&2
    exit 4
  fi

  update_decision "$id" '.status = "answered" | .answer = $a | .answered_by = $by | .answered_at = $now | .updated_at = $now' \
    --arg a "$answer" --arg by "$by" --argjson now "$now"
  log_event "$(jq -cn --arg id "$id" --arg by "$by" --argjson now "$now" '{ts: $now, type: "answer", id: $id, by: $by}')"

  local gate task_id
  gate="$(jq -r '.gate // empty' "$f")"
  task_id="$(jq -r '.task_id // empty' "$f")"
  if [ -n "$gate" ]; then
    local result=rejected
    if grep -qiE -- "$(approve_re)" <<<"$answer"; then
      result=approved
    fi
    log_event "$(jq -c --arg result "$result" --argjson now "$now" \
      '{ts: $now, type: "approval", decision_id: .id, task_id: (.task_id // null), stage: (.stage // null),
        gate: .gate, answer: .answer, result: $result, answered_by: .answered_by, answered_at: .answered_at,
        relayed_at: null}' "$f")"
    if [ -n "$task_id" ]; then
      local tf; tf="$(task_path "$task_id")"
      if [ -f "$tf" ]; then
        write_atomic "$tf" "$(jq --arg id "$id" --arg result "$result" --arg by "$by" --argjson now "$now" '
          .gates = [ (.gates // [])[] | if .decision_id == $id then
                       .status = $result
                       | .approved_by = (if $result == "approved" then $by else null end)
                       | .approved_at = (if $result == "approved" then $now else null end)
                       | .answered_by = $by
                     else . end ]
          | .updated_at = $now' "$tf")"
      fi
    fi
    echo "$id answered ($gate gate $result)"
  else
    echo "$id answered"
  fi
}

mark_status() {  # mark_status ID STATUS [reason]
  local id="$1" st="$2" reason="${3:-}" now
  now="$(now_ms)"
  update_decision "$id" '.status = $st | .updated_at = $now | (if $st == "relayed" then .relayed_at = $now else . end)' \
    --arg st "$st" --argjson now "$now"
  log_event "$(jq -cn --arg id "$id" --arg st "$st" --arg r "$reason" --argjson now "$now" \
    '{ts: $now, type: "mark", id: $id, status: $st} + (if $r == "" then {} else {reason: $r} end)')"
}

cmd_mark() {
  need_jq
  local id="${1:-}" st="${2:-}"
  case "$st" in
    relayed|stale|timeout|unauthorized) ;;
    *) sub_usage mark >&2; exit 2 ;;
  esac
  mark_status "$id" "$st"
  echo "$id $st"
}

# ---------------------------------------------------------------- tasks
cmd_task() {
  need_jq
  local sub="${1:-}"
  [ $# -gt 0 ] && shift
  case "$sub" in
    new) task_new "$@" ;;
    stage) task_stage "$@" ;;
    ls) task_ls "$@" ;;
    show) [ -n "${1:-}" ] || { sub_usage task show >&2; exit 2; }
          local tf; tf="$(task_path "$1")"; [ -f "$tf" ] || die "no such task: $1"; jq . "$tf" ;;
    *) sub_usage task >&2; exit 2 ;;
  esac
}

task_new() {
  local owner="" title="" stage="plan"
  while [ $# -gt 0 ]; do
    case "$1" in
      --owner) shift; owner="${1:-}" ;;
      --stage) shift; stage="${1:-}" ;;
      -*) die "task new: unknown option $1" ;;
      *) [ -z "$title" ] || die "task new: only one title"; title="$1" ;;
    esac
    shift
  done
  [ -n "$owner" ] && [ -n "$title" ] || { sub_usage task new >&2; exit 2; }
  valid_stage "$stage" || die "task new: unknown stage '$stage' (one of: $STAGES)"
  local now id
  now="$(now_ms)"
  id="$(new_id t "$now")"
  mkdir -p "$BOARD_HOME/tasks"
  write_atomic "$(task_path "$id")" "$(jq -n --arg id "$id" --arg title "$title" --arg owner "$owner" \
    --arg stage "$stage" --argjson now "$now" '
    { id: $id, title: $title, owner: $owner, stage: $stage,
      artifacts: { intent: null, spec: null, plan: null, evals: null, review: null },
      gates: [], created_at: $now, updated_at: $now }')"
  log_event "$(jq -cn --arg id "$id" --arg owner "$owner" --arg stage "$stage" --argjson now "$now" \
    '{ts: $now, type: "task", id: $id, owner: $owner, stage: $stage, action: "new"}')"
  echo "$id"
}

task_stage() {
  local id="${1:-}" stage="${2:-}" arts=()
  if [ $# -ge 2 ]; then shift 2; else set --; fi
  while [ $# -gt 0 ]; do
    case "$1" in
      --artifact) shift; arts+=("${1:-}") ;;
      *) die "task stage: unknown option $1" ;;
    esac
    shift
  done
  [ -n "$id" ] && [ -n "$stage" ] || { sub_usage task stage >&2; exit 2; }
  valid_stage "$stage" || die "task stage: unknown stage '$stage' (one of: $STAGES)"
  local tf; tf="$(task_path "$id")"
  [ -f "$tf" ] || die "no such task: $id"
  local a key arts_json="{}"
  for a in "${arts[@]+"${arts[@]}"}"; do
    key="${a%%=*}"
    [ "$key" != "$a" ] && [ -n "${a#*=}" ] || die "task stage: --artifact needs key=ref"
    case " $ARTIFACT_KEYS " in *" $key "*) ;; *) die "task stage: unknown artifact '$key' (one of: $ARTIFACT_KEYS)" ;; esac
    arts_json="$(jq -c --arg k "$key" --arg v "${a#*=}" '.[$k] = $v' <<<"$arts_json")"
  done
  local now; now="$(now_ms)"
  write_atomic "$tf" "$(jq --arg stage "$stage" --argjson arts "$arts_json" --argjson now "$now" \
    '.stage = $stage | .artifacts = ((.artifacts // {}) + $arts) | .updated_at = $now' "$tf")"
  log_event "$(jq -cn --arg id "$id" --arg stage "$stage" --argjson arts "$arts_json" --argjson now "$now" \
    '{ts: $now, type: "task", id: $id, stage: $stage, artifacts: $arts, action: "stage"}')"
  echo "$id $stage"
}

task_ls() {
  local json=0
  [ "${1:-}" = "--json" ] && json=1
  local files=("$BOARD_HOME"/tasks/*.json)
  if [ ! -e "${files[0]}" ]; then
    if [ "$json" = 1 ]; then echo "[]"; else echo "no tasks"; fi
    return 0
  fi
  local all; all="$(jq -s 'sort_by(.updated_at)' "${files[@]}")"
  if [ "$json" = 1 ]; then echo "$all"; return 0; fi
  {
    printf 'ID\tOWNER\tSTAGE\tGATES\tARTIFACTS\tTITLE\n'
    jq -r "$JQ_SAFE"'.[] | [ .id, .owner, .stage,
      ((.gates // []) | if length == 0 then "-" else map(.stage + "/" + .gate + ":" + .status) | join(",") end),
      ((.artifacts // {}) | to_entries | map(select(.value != null) | .key) | if length == 0 then "-" else join(",") end),
      (.title | gsub("[\t\n]"; " ") | .[0:50]) ] | map(safe) | @tsv' <<<"$all"
  } | column -t -s $'\t'
}

# ---------------------------------------------------------------- limit
cmd_limit() {
  case "${1:-}" in
    "") python3 "$REPO/lib/limit.py" show ;;
    --json) python3 "$REPO/lib/limit.py" show --json ;;
    --clear) python3 "$REPO/lib/limit.py" clear >/dev/null; echo "usage-limit episode cleared" ;;
    *) sub_usage limit >&2; exit 2 ;;
  esac
}

# ---------------------------------------------------------------- press
cmd_press() {
  need_jq
  local code="${1:-}" action="${2:-}" expect="" allow_trunc=0
  if [ $# -ge 2 ]; then shift 2; else set --; fi
  while [ $# -gt 0 ]; do
    case "$1" in
      --expect) shift; expect="${1:-}" ;;
      --allow-truncated) allow_trunc=1 ;;
      *) die "press: unknown option $1" ;;
    esac
    shift
  done
  case "$action" in allow|deny) ;; *) code="" ;; esac
  [ -n "$code" ] && [ -n "$expect" ] || { sub_usage press >&2; exit 2; }

  local now; now="$(now_ms)"
  local dec_id=""
  if compgen -G "$BOARD_HOME/decisions/*.json" >/dev/null; then
    dec_id="$(jq -rs --arg t "$expect" '[ .[] | select(.kind == "permission" and .tool_use_id == $t) ]
      | sort_by(.created_at) | last | .id // empty' "$BOARD_HOME"/decisions/*.json 2>/dev/null)"
  fi

  attempt() {  # attempt RESULT REASON [pane]
    log_event "$(jq -cn --argjson now "$now" --arg code "$code" --arg action "$action" --arg exp "$expect" \
      --arg result "$1" --arg reason "$2" --arg pane "${3:-}" --arg dec "$dec_id" \
      '{ts: $now, type: "press", code: $code, action: $action, expect: $exp, result: $result, reason: $reason}
       + (if $pane == "" then {} else {pane: $pane} end) + (if $dec == "" then {} else {decision: $dec} end)')"
  }
  # Not authorized (no keys sent, decision left as it is): exit 4.
  refuse_auth() {
    echo "board press: refused — $1" >&2
    attempt unauthorized "$1"
    exit 4
  }
  # The screen / state no longer matches (no keys sent, decision marked stale): exit 3.
  refuse() {
    echo "board press: refused — $1" >&2
    attempt refused "$1" "${2:-}"
    [ -n "$dec_id" ] && mark_status "$dec_id" stale "press refused: $1" >/dev/null 2>&1
    exit 3
  }

  # 1. A human approver must have answered this exact decision with this exact action.
  [ -n "$dec_id" ] || refuse_auth "no local permission decision for tool_use_id $expect"
  local df; df="$(dec_path "$dec_id")"
  local d_status d_answer d_by d_trunc d_sha
  d_status="$(jq -r '.status // empty' "$df")"
  d_answer="$(jq -r '(.answer // "") | ascii_downcase | gsub("^\\s+|\\s+$"; "")' "$df")"
  d_by="$(jq -r '.answered_by // empty' "$df")"
  d_trunc="$(jq -r '.summary_truncated // false' "$df")"
  d_sha="$(jq -r '.summary_sha256 // empty' "$df")"
  [ "$d_status" = answered ] || refuse_auth "decision $dec_id is '$d_status', not answered (run board answer first)"
  [ "$d_answer" = "$action" ] || refuse_auth "decision $dec_id was answered '$d_answer', not '$action'"
  if [ -z "$d_by" ] || ! allowed_by "$df" "$d_by"; then
    refuse_auth "answered_by '$d_by' is not an approver (or no approvers configured)"
  fi
  # 2. A truncated summary means the human did not see the whole input.
  if [ "$d_trunc" = true ] && [ "$allow_trunc" = 0 ]; then
    refuse_auth "the summary of $dec_id is truncated; read the full input in the pane, then pass --allow-truncated"
  fi

  # 3. Keys first, so a config problem never leaves a half-checked press.
  local keys_json key keys=()
  if [ "$action" = allow ]; then keys_json="$(cfg_get press.allow_keys)"; else keys_json="$(cfg_get press.deny_keys)"; fi
  while IFS= read -r key; do [ -n "$key" ] && keys+=("$key"); done < <(jq -r '.[]' <<<"$keys_json" 2>/dev/null)
  [ ${#keys[@]} -gt 0 ] || refuse "no keys configured for $action"

  refresh
  local snap="$BOARD_HOME/snapshot.json"
  [ -f "$snap" ] || refuse "no snapshot"
  local row
  row="$(jq -c --arg c "$code" '[ .sessions[] | select(.code == $c or ((.aliases // []) | index($c))) ] | first // empty' "$snap")"
  [ -n "$row" ] || refuse "unknown session $code"
  local sid pane tmux_target
  sid="$(jq -r '.session_id // empty' <<<"$row")"
  pane="$(jq -r '.tmux_pane // empty' <<<"$row")"
  tmux_target="$(jq -r '.tmux // empty' <<<"$row")"
  [ -n "$sid" ] || refuse "session $code is not running"
  [ -n "$pane" ] || refuse "session $code has no tmux pane"

  local sf="$BOARD_HOME/state/$sid.json"
  [ -f "$sf" ] || refuse "no hook state for $code (is the hook installed?)" "$pane"
  local st_state st_pending st_pane st_sha
  st_state="$(jq -r '.state // empty' "$sf")"
  st_pending="$(jq -r '.pending.tool_use_id // empty' "$sf")"
  st_pane="$(jq -r '.tmux_pane // empty' "$sf")"
  st_sha="$(jq -r '.pending.summary_sha256 // empty' "$sf")"
  [ "$st_state" = "needs-you" ] || refuse "$code state is '$st_state', not needs-you" "$pane"
  [ "$st_pending" = "$expect" ] || refuse "pending tool_use_id is '${st_pending:-none}', expected '$expect'" "$pane"
  if [ -z "$d_sha" ] || [ -z "$st_sha" ]; then
    refuse "no input hash on the decision or the pending prompt; cannot bind the press to it" "$pane"
  fi
  [ "$st_sha" = "$d_sha" ] || refuse "pending input differs from the decision's (sha256 mismatch)" "$pane"
  if [ -n "$st_pane" ] && [ "$st_pane" != "$pane" ]; then
    refuse "pane mismatch: hook saw $st_pane, registry says $pane" "$pane"
  fi
  if [ -n "$tmux_target" ]; then
    local pane_sess
    pane_sess="$(tmux display-message -p -t "$pane" '#{session_name}' 2>/dev/null)" || refuse "tmux pane $pane not found" "$pane"
    [ "$pane_sess" = "${tmux_target%%:*}" ] || refuse "pane $pane belongs to tmux session '$pane_sess', expected '${tmux_target%%:*}'" "$pane"
  fi

  local regex lines full screen
  regex="$(cfg_get press.prompt_regex)"
  lines="$(cfg_get press.lines 30)"
  case "$lines" in ''|*[!0-9]*) lines=30 ;; esac
  full="$(tmux capture-pane -p -t "$pane" 2>/dev/null)" || refuse "capture-pane failed for $pane" "$pane"
  screen="$(sed -e :a -e '/^[[:space:]]*$/{$d;N;ba' -e '}' <<<"$full" | tail -n "$lines")"
  grep -Eq -- "$regex" <<<"$screen" || refuse "no permission prompt visible in pane $pane" "$pane"

  # 4. The prompt on screen must be about this input: the start of the summary (whitespace
  #    removed, up to 40 characters, before any [REDACTED]) must be visible in the pane.
  local summ bind flat
  summ="$(jq -r '.pending.summary // ""' "$sf")"
  bind="${summ%%\[REDACTED*}"
  bind="$(tr -d '[:space:]' <<<"$bind")"
  bind="${bind:0:40}"
  flat="$(tr -d '[:space:]' <<<"$full")"
  if [ ${#bind} -lt 8 ] && [ "$summ" != "${summ%%\[REDACTED*}" ]; then
    refuse "too little of the summary is left before [REDACTED] to check it on screen" "$pane"
  fi
  [ -n "$bind" ] || refuse "empty summary; cannot check what the prompt is about" "$pane"
  local seen=0
  [[ $flat == *"$bind"* ]] && seen=1
  if [ "$seen" = 0 ]; then
    case "$summ" in
      /*|~*) local base="${summ##*/}"
             base="$(tr -d '[:space:]' <<<"$base")"
             [ ${#base} -ge 6 ] && [[ $flat == *"$base"* ]] && seen=1 ;;
    esac
  fi
  [ "$seen" = 1 ] || refuse "the pending input ('${bind}') is not visible in pane $pane" "$pane"

  # 5. Last look at the state right before typing: abort if the pending prompt changed.
  if [ "$(jq -r '[.state, (.pending.tool_use_id // ""), (.pending.summary_sha256 // "")] | join(" ")' "$sf")" \
       != "needs-you $expect $st_sha" ]; then
    refuse "pending prompt changed while checking" "$pane"
  fi

  tmux send-keys -t "$pane" "${keys[@]}" || { attempt failed "send-keys failed" "$pane"; exit 1; }
  attempt sent "ok" "$pane"
  mark_status "$dec_id" relayed >/dev/null 2>&1
  echo "pressed $action (${keys[*]}) in $code pane $pane"
}

# ---------------------------------------------------------------- notify
# board_link [ID] — the public board link for a decision/message/consensus id (no ID or an id
# that fails its strict pattern: the board root). Prints nothing when no board URL is set.
board_link() { python3 "$FLEET" board-link "${1:-}" 2>/dev/null || true; }

cmd_notify() {
  local link_to="" want_link=0
  if [ "${1:-}" = --link ]; then
    [ $# -ge 2 ] || { sub_usage notify >&2; exit 2; }
    want_link=1; link_to="$2"; shift 2
    [ "$link_to" = root ] && link_to=""
  fi
  local text="${1:-}"
  [ -n "$text" ] || { sub_usage notify >&2; exit 2; }
  if [ "$want_link" = 1 ]; then
    local link; link="$(board_link "$link_to")"
    [ -n "$link" ] && text="$text"$'\n'"$link"
  fi
  local url="${SLACK_WEBHOOK_URL:-}"
  local envf; envf="$(config_dir)/.env"
  if [ -z "$url" ] && [ -f "$envf" ]; then
    url="$(sed -n -E 's/^[[:space:]]*(export[[:space:]]+)?SLACK_WEBHOOK_URL[[:space:]]*=[[:space:]]*//p' "$envf" | tail -n 1)"
    url="${url%\"}"; url="${url#\"}"; url="${url%\'}"; url="${url#\'}"
  fi
  [ -n "$url" ] || return 0
  command -v curl >/dev/null 2>&1 || return 0
  local payload
  # Slack control sequences (<!channel>, <url|label>, <@U...>) come from & < >: escape them, as
  # lib/notify.py slack_escape does, so text from sessions or the owner can't ping or link.
  payload="$(jq -cn --arg t "$text" '{text: ($t | gsub("&"; "&amp;") | gsub("<"; "&lt;") | gsub(">"; "&gt;"))}')"
  # The webhook URL is a secret: give it to curl in a config on stdin, never on argv.
  cfgq() { local v="${1//\\/\\\\}"; printf '"%s"' "${v//\"/\\\"}"; }
  local code
  code="$(printf 'url = %s\nheader = "content-type: application/json"\ndata-binary = %s\n' \
            "$(cfgq "$url")" "$(cfgq "$payload")" \
          | curl -s -m 10 -o /dev/null -w '%{http_code}' -K - 2>/dev/null)"
  log_event "$(jq -cn --argjson now "$(now_ms)" --arg c "${code:-000}" '{ts: $now, type: "notify", http: $c}')"
  [ "${code:-000}" = 200 ] || echo "board notify: webhook returned ${code:-000}" >&2
  return 0
}

# Best effort: a notify problem (no channel configured, webhook down) never fails the caller.
# notify_quiet TEXT [ID|root] — with a second argument the board link is appended (when set).
notify_quiet() { if [ $# -ge 2 ]; then ( cmd_notify --link "$2" "$1" ) || true; else ( cmd_notify "$1" ) || true; fi; }

# ---------------------------------------------------------------- owner away & consensus
# The owner is away while $BOARD_HOME/owner-away exists, whatever its content: a legacy
# free-text file counts as away too. `board away on` writes {since, by, said}.
AWAY_FILE="$BOARD_HOME/owner-away"
# Never decided by consensus, whatever every session says: these wait for the owner.
RED_LINES=("production deploys"
           "deleting real data"
           "irreversible operations"
           "touching shared production or third-party data"
           "publishing externally"
           "loosening permissions or security settings")
red_lines_text() {
  local r
  echo "red lines (never by consensus; they wait for the owner):"
  for r in "${RED_LINES[@]}"; do echo "  - $r"; done
}
red_lines_inline() { local IFS=';'; printf '%s' "${RED_LINES[*]}" | sed 's/;/; /g'; }

# Writers of owner-away and consensus/ hold one lock, so `away off` and a vote never interleave.
LOCKED=0
lock_board() {
  [ "$LOCKED" = 1 ] && return 0
  command -v flock >/dev/null 2>&1 || die "flock is required for board away / board consensus (util-linux)"
  exec 8>>"$BOARD_HOME/consensus.lock" || die "cannot open $BOARD_HOME/consensus.lock"
  flock -w 10 8 || die "another away/consensus change holds the lock; try again"
  LOCKED=1
}
unlock_board() {
  [ "$LOCKED" = 1 ] || return 0
  flock -u 8 2>/dev/null; exec 8>&-
  LOCKED=0
}

no_ctl() {  # no_ctl NAME VALUE MAX — one line of printable text, at most MAX characters
  [[ $2 =~ [[:cntrl:]] ]] && die "$1 must be one line without control characters"
  [ "${#2}" -le "$3" ] || die "$1 is longer than $3 characters"
  return 0
}
cap() {  # cap NAME VALUE MAX — free text (newlines allowed), at most MAX characters
  [ "${#2}" -le "$3" ] || die "$1 is longer than $3 characters"
  return 0
}
valid_code() { [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$ ]]; }

# Free text that BOARD may quote to every session must never look like a relay ("[BOARD decision
# ...]", "[BOARD ask ...]"): "[BOARD" becomes "(BOARD", case-insensitively (lib/away.py does the same).
JQ_DEFANG='def defang: gsub("\\[(?<b>board)"; "(\(.b)"; "i");'
defang() { jq -rn --arg t "$1" "$JQ_DEFANG"'$t | defang'; }

# code_of NAME → the fleet code NAME stands for (a code or one of its aliases), else NAME.
code_of() {
  local c
  c="$(python3 "$FLEET" sessions 2>/dev/null | jq -r --arg n "$1" \
        'select(.code == $n or ((.aliases // []) | index($n) != null)) | .code' 2>/dev/null | head -n 1)"
  echo "${c:-$1}"
}

# Votes are self-attested (--from is declared by the caller). Inside tmux, at least refuse a
# --from that is not this tmux session (or an alias of the same fleet code): exit 4, logged.
self_check() {  # self_check CODE ACTION [ID]
  [ -n "${TMUX:-}" ] || return 0
  command -v tmux >/dev/null 2>&1 || return 0
  local me
  if [ -n "${TMUX_PANE:-}" ]; then
    me="$(tmux display-message -p -t "$TMUX_PANE" '#S' 2>/dev/null)" || return 0
  else
    me="$(tmux display-message -p '#S' 2>/dev/null)" || return 0
  fi
  [ -n "$me" ] || return 0
  [ "$me" = "$1" ] && return 0
  [ "$(code_of "$me")" = "$(code_of "$1")" ] && return 0
  log_event "$(jq -cn --argjson now "$(now_ms)" --arg a "$2" --arg id "${3:-}" --arg by "$1" --arg me "$me" \
    '{ts: $now, type: "consensus", action: $a, by: $by, tmux_session: $me, result: "refused",
      reason: "--from is not this tmux session"} + (if $id == "" then {} else {id: $id} end)')"
  echo "board consensus: refused — --from $1, but this is tmux session '$me'; a session votes and proposes only as itself" >&2
  exit 4
}

# away_record → prints the record as compact JSON {since, by, said[, legacy]}; 1 when not away.
away_record() {
  [ -e "$AWAY_FILE" ] || [ -L "$AWAY_FILE" ] || return 1
  local rec mt
  # Exactly one JSON object (within the first 16 KiB, as lib/away.py reads it) is a record;
  # anything else (free text, several objects, a non-object) is a legacy file: still away.
  if rec="$( { head -c 16384 "$AWAY_FILE" 2>/dev/null || true; } | jq -sce "$JQ_DEFANG"'
               if length == 1 and (.[0] | type) == "object"
               then .[0] | {since: (.since // null), by: (.by // null), said: (.said // null)}
                 | (.by, .said) |= (if type == "string" then defang else . end)
               else empty end' 2>/dev/null)"; then
    echo "$rec"
    return 0
  fi
  mt="$(stat -c %Y "$AWAY_FILE" 2>/dev/null || stat -f %m "$AWAY_FILE" 2>/dev/null || echo 0)"
  case "$mt" in ''|*[!0-9]*) mt=0 ;; esac
  { head -c 2000 "$AWAY_FILE" 2>/dev/null || true; } \
    | jq -Rsc --argjson mt "$(( mt * 1000 ))" "$JQ_DEFANG"'{since: $mt, by: null, said: (sub("\\s+$"; "") | defang), legacy: true}'
}

JQ_TS='def ts: if type == "number" and . > 0 then (. / 1000 | floor | todate) else "-" end;'
JQ_LINE='def line: tostring | gsub("[\r\n\t]+"; " ") | gsub("[\u0000-\u001f\u007f-\u009f]"; "?");'

away_line() {  # away_line RECORD_JSON
  jq -r "$JQ_TS$JQ_LINE"'"owner away since " + (.since | ts) + " (by " + ((.by // "?") | line) + ")"
    + (if .legacy then " [free-text record]" else "" end)
    + (if (.said // "") != "" then ": \"" + (.said | line | .[0:300]) + "\"" else "" end)' <<<"$1"
}

cmd_away() {
  need_jq
  local sub="${1:-}"
  [ $# -gt 0 ] && shift
  case "$sub" in
    on|off) away_set "$sub" "$@" ;;
    status) away_status "$@" ;;
    *) sub_usage away >&2; exit 2 ;;
  esac
}

away_status() {
  local quiet=0 json=0 rec
  while [ $# -gt 0 ]; do
    case "$1" in
      --quiet|-q) quiet=1 ;;
      --json) json=1 ;;
      *) echo "board: away status: unknown option $1" >&2; sub_usage away status >&2; exit 2 ;;
    esac
    shift
  done
  if ! rec="$(away_record)"; then
    if [ "$json" = 1 ]; then echo null; elif [ "$quiet" = 0 ]; then echo "owner is not away"; fi
    return 1
  fi
  if [ "$json" = 1 ]; then
    echo "$rec"
  elif [ "$quiet" = 0 ]; then
    away_line "$rec"
    echo "  sessions may decide cross-session questions by explicit consensus (board consensus);"
    echo "  red lines and board asks wait for the owner."
  fi
  return 0
}

away_set() {
  local action="$1"; shift
  local by="" said="" replace=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --by) shift; by="${1:-}" ;;
      --said) shift; said="${1:-}" ;;
      --replace) [ "$action" = on ] || die "away off: unknown option --replace"; replace=1 ;;
      *) die "away $action: unknown option $1" ;;
    esac
    shift
  done
  if [ -z "$by" ] || { [ "$action" = on ] && [ -z "${said//[[:space:]]/}" ]; }; then
    sub_usage away "$action" >&2; exit 2
  fi
  # --by is quoted to every session: a session code or board:<identity> (an email or "local"),
  # never free text.
  [[ $by =~ ^(board:)?[A-Za-z0-9][A-Za-z0-9@._+:-]{0,199}$ ]] \
    || die "away $action: --by must be a session code or board:<identity> (letters, digits, @ . _ + : -)"
  cap "--said" "$said" 2000
  said="$(defang "$said")"

  lock_board
  local now cur="" rec
  now="$(now_ms)"
  cur="$(away_record)" || cur=""
  if [ "$action" = on ]; then
    if [ -n "$cur" ] && [ "$replace" = 0 ]; then
      unlock_board
      away_line "$cur"
      echo "board away: already away; the record above is kept (--replace overwrites it)" >&2
      return 0
    fi
    # A new away episode starts: anything still pending from an earlier one (file removed by
    # hand, or a record replaced) goes back to the owner first; it was never agreed under this one.
    local stale
    stale="$(consensus_owner_back "$now" "$(if [ -n "$cur" ]; then echo "away record replaced"; else echo "owner-away file removed"; fi)")"
    rec="$(jq -n --argjson now "$now" --arg by "$by" --arg said "$said" '{since: $now, by: $by, said: $said}')"
    rm -f "$AWAY_FILE"   # a legacy file may be a symlink or have looser modes: start fresh
    write_atomic "$AWAY_FILE" "$rec" || die "cannot write $AWAY_FILE"
    chmod 600 "$AWAY_FILE" 2>/dev/null
    log_event "$(jq -cn --argjson now "$now" --arg by "$by" --arg said "$said" --argjson prev "${cur:-null}" \
      '{ts: $now, type: "away", action: "on", by: $by, said: $said} + (if $prev == null then {} else {replaced: $prev} end)')"
    unlock_board
    away_line "$rec"
    [ -n "$stale" ] && echo "earlier pending consensus returned to the owner: $(paste -sd " " - <<<"$stale")" >&2
    notify_quiet "$(jq -rn --arg by "$by" --arg said "$said" "$JQ_LINE"'
      "[board] Owner away (set by \($by | line)): \"\($said | line | .[0:300])\" — sessions may decide by explicit consensus; red lines and board asks wait for the owner."')"
    return 0
  fi

  if [ -z "$cur" ]; then
    unlock_board
    echo "owner is not away; nothing to do"
    return 0
  fi
  rm -f "$AWAY_FILE" || die "cannot remove $AWAY_FILE"
  local returned
  returned="$(consensus_owner_back "$now" "$by")"
  log_event "$(jq -cn --argjson now "$now" --arg by "$by" --arg said "$said" --argjson prev "$cur" \
    --arg ret "$returned" '{ts: $now, type: "away", action: "off", by: $by, previous: $prev,
      returned: ($ret | split("\n") | map(select(. != "")))} + (if $said == "" then {} else {said: $said} end)')"
  unlock_board
  local n=0
  [ -n "$returned" ] && n="$(wc -l <<<"$returned" | tr -d ' ')"
  echo "owner back (by $by); $n pending consensus item(s) returned to the owner${returned:+: $(paste -sd " " - <<<"$returned")}"
  notify_quiet "$(jq -rn --arg by "$by" --arg n "$n" --arg ret "$returned" "$JQ_LINE"'
    "[board] Owner back (by \($by | line)); away mode off."
    + (if $n == "0" then "" else " \($n) pending consensus item(s) returned to the owner: \($ret | split("\n") | map(select(. != "")) | join(", "))" end)')" \
    "$( [ "$n" = 1 ] && printf '%s' "$returned" || echo root )"
}

cons_path() {
  [[ $1 =~ ^c-[0-9]+-[a-z0-9]+$ ]] || die "invalid consensus id: $1"
  echo "$BOARD_HOME/consensus/$1.json"
}

# consensus_owner_back_one FILE NOW BY — (lock held) a pending item becomes owner_back; prints its id.
consensus_owner_back_one() {
  local f="$1" id new
  [ "$(jq -r '.status // empty' "$f" 2>/dev/null)" = pending ] || return 0
  new="$(jq --argjson now "$2" --arg by "$3" \
    '.status = "owner_back" | .decided_at = $now | .updated_at = $now | .returned_by = $by' "$f")" \
    || { echo "board: cannot update $f; left as it is" >&2; return 0; }
  write_atomic "$f" "$new" || return 0
  id="$(jq -r '.id' "$f")"
  log_event "$(jq -cn --argjson now "$2" --arg id "$id" --arg by "$3" \
    '{ts: $now, type: "consensus", action: "owner_back", id: $id, by: $by}')"
  echo "$id"
}

# consensus_owner_back NOW BY — (lock held) every pending item becomes owner_back; prints the ids.
consensus_owner_back() {
  local f
  for f in "$BOARD_HOME"/consensus/c-*.json; do
    [ -f "$f" ] || continue
    consensus_owner_back_one "$f" "$1" "$2"
  done
}

# The owner-away file may be removed by hand: pending items then also go back to the owner.
sweep_if_back() {
  away_record >/dev/null && return 0
  compgen -G "$BOARD_HOME/consensus/c-*.json" >/dev/null || return 0
  [ -n "$(jq -r 'select(.status == "pending") | .id' "$BOARD_HOME"/consensus/c-*.json 2>/dev/null)" ] || return 0
  local was=$LOCKED returned
  lock_board
  away_record >/dev/null && { [ "$was" = 1 ] || unlock_board; return 0; }
  returned="$(consensus_owner_back "$(now_ms)" "owner-away file removed")"
  [ "$was" = 1 ] || unlock_board
  [ -n "$returned" ] && notify_quiet "[board] Owner back (owner-away file removed); pending consensus returned to the owner: $(paste -sd " " - <<<"$returned")" \
    "$( [ "$(wc -l <<<"$returned")" -eq 1 ] && printf '%s' "$returned" || echo root )"
  return 0
}

cmd_consensus() {
  need_jq
  local sub="${1:-}"
  [ $# -gt 0 ] && shift
  case "$sub" in
    propose) cons_propose "$@" ;;
    vote) cons_vote "$@" ;;
    ls) cons_ls "$@" ;;
    show) cons_show "$@" ;;
    *) sub_usage consensus >&2; exit 2 ;;
  esac
}

cons_propose() {
  local from="" to="" ref="" text=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --from) shift; from="${1:-}" ;;
      --to) shift; to="${to:+$to,}${1:-}" ;;
      --ref) shift; ref="${1:-}" ;;
      -*) die "consensus propose: unknown option $1" ;;
      *) [ -z "$text" ] || die "consensus propose: only one proposal"; text="$1" ;;
    esac
    shift
  done
  [ -n "$from" ] && [ -n "$to" ] && [ -n "${text//[[:space:]]/}" ] || { sub_usage consensus propose >&2; exit 2; }
  valid_code "$from" || die "consensus propose: invalid session code: $from"
  no_ctl "--ref" "$ref" 500
  ref="$(defang "$ref")"
  cap "proposal" "$text" 4000
  local parts=("$from") p q seen
  local IFS_OLD="$IFS"; IFS=','; read -ra tos <<<"$to"; IFS="$IFS_OLD"
  for p in "${tos[@]}"; do
    p="${p//[[:space:]]/}"
    [ -n "$p" ] || continue
    valid_code "$p" || die "consensus propose: invalid session code: $p"
    seen=0
    for q in "${parts[@]}"; do [ "$q" = "$p" ] && seen=1; done
    [ "$seen" = 1 ] || parts+=("$p")
  done
  [ "${#parts[@]}" -ge 2 ] || die "consensus propose: --to must name at least one other session"
  self_check "$from" propose
  text="$(defang "$text")"

  lock_board
  local away
  if ! away="$(away_record)"; then
    unlock_board
    echo "board consensus: refused — the owner is not away (board away status); ask the owner" >&2
    exit 1
  fi
  local now id parts_json
  now="$(now_ms)"
  id="$(new_id c "$now")"
  parts_json="$(printf '%s\n' "${parts[@]}" | jq -R . | jq -sc .)"
  mkdir -p "$BOARD_HOME/consensus"
  local new
  new="$(jq -n --arg id "$id" --arg from "$from" --arg ref "$ref" \
    --arg text "$text" --argjson parts "$parts_json" --argjson away "$away" --argjson now "$now" '
    { id: $id, kind: "consensus", from: $from, participants: $parts,
      ref: (if $ref == "" then null else $ref end), proposal: $text, status: "pending",
      votes: [ { by: $from, vote: "agree", note: "proposer", at: $now } ],
      away: { since: $away.since, by: $away.by },
      created_at: $now, updated_at: $now, decided_at: null }')" || { unlock_board; die "cannot build consensus $id"; }
  write_atomic "$(cons_path "$id")" "$new" || { unlock_board; die "cannot write consensus $id"; }
  log_event "$(jq -cn --argjson now "$now" --arg id "$id" --arg from "$from" --argjson parts "$parts_json" \
    --arg ref "$ref" '{ts: $now, type: "consensus", action: "propose", id: $id, from: $from, participants: $parts}
      + (if $ref == "" then {} else {ref: $ref} end)')"
  unlock_board
  echo "$id"
  {
    echo "consensus $id: waiting for an explicit agree from: ${parts[*]:1}"
    echo "  send the proposal to each of them; silence is not agreement, one objection parks it for the owner."
    echo "  each votes with: board consensus vote $id agree|object --from <CODE> [--note ...]"
    red_lines_text | sed 's/^/  /'
  } >&2
}

# The latest vote of each participant decides; status: pending → agreed | objected.
JQ_TALLY='def tally: (reduce .votes[] as $x ({}; .[$x.by] = $x.vote)) as $last
  | if any($last[]; . == "object") then "objected"
    elif all(.participants[]; $last[.] == "agree") then "agreed" else "pending" end;'

cons_vote() {
  local id="${1:-}" vote="${2:-}" from="" note=""
  if [ $# -ge 2 ]; then shift 2; else set --; fi
  while [ $# -gt 0 ]; do
    case "$1" in
      --from) shift; from="${1:-}" ;;
      --note) shift; note="${1:-}" ;;
      *) die "consensus vote: unknown option $1" ;;
    esac
    shift
  done
  case "$vote" in agree|object) ;; *) id="" ;; esac
  [ -n "$id" ] && [ -n "$from" ] || { sub_usage consensus vote >&2; exit 2; }
  cap "--note" "$note" 1000
  note="$(defang "$note")"
  local f; f="$(cons_path "$id")"
  [ -f "$f" ] || die "no such consensus item: $id"
  self_check "$from" vote "$id"

  lock_board
  sweep_if_back
  local now st prev
  now="$(now_ms)"
  if [ "$(jq --arg f "$from" '.participants | index($f) != null' "$f")" != true ]; then
    unlock_board
    log_event "$(jq -cn --argjson now "$now" --arg id "$id" --arg by "$from" \
      '{ts: $now, type: "consensus", action: "vote", id: $id, by: $by, result: "refused", reason: "not a participant"}')"
    echo "board consensus: refused — $from is not a participant of $id" >&2
    exit 4
  fi
  st="$(jq -r '.status' "$f")"
  if [ "$st" != pending ]; then
    unlock_board
    die "consensus $id is already $st$( [ "$st" = owner_back ] && echo ' (the owner is back: ask the owner)')"
  fi
  # Only the away episode the item was proposed in counts: if the record changed since (removed and
  # set again, --replace, an edited legacy file), the item goes back to the owner.
  local cur_since item_since
  cur_since="$(away_record | jq -c '.since')"
  item_since="$(jq -c '.away.since' "$f")"
  if [ "$cur_since" != "$item_since" ]; then
    local returned
    returned="$(consensus_owner_back_one "$f" "$now" "owner-away record changed")"
    unlock_board
    [ -n "$returned" ] && notify_quiet "[board] Consensus $id returned to the owner: it was proposed in an earlier away period"
    die "consensus $id belongs to an earlier away period; it went back to the owner (ask the owner)"
  fi
  prev="$(jq -r --arg f "$from" '[.votes[] | select(.by == $f)] | last | .vote // empty' "$f")"
  if [ "$prev" = "$vote" ]; then
    unlock_board
    die "$from already voted $vote on $id"
  fi
  if [ "$prev" = object ]; then
    unlock_board
    die "$from objected to $id; an objection is never turned into agreement (the owner decides)"
  fi
  local new
  new="$(jq --arg by "$from" --arg v "$vote" --arg note "$note" --argjson now "$now" "$JQ_TALLY"'
    .votes += [ { by: $by, vote: $v, note: (if $note == "" then null else $note end), at: $now } ]
    | .status = tally | .updated_at = $now
    | (if .status != "pending" then .decided_at = $now else . end)' "$f")" || { unlock_board; die "failed to update $id"; }
  write_atomic "$f" "$new" || { unlock_board; die "failed to write $id"; }
  st="$(jq -r '.status' "$f")"
  log_event "$(jq -cn --argjson now "$now" --arg id "$id" --arg by "$from" --arg v "$vote" --arg st "$st" \
    '{ts: $now, type: "consensus", action: "vote", id: $id, by: $by, vote: $v, status: $st}')"
  unlock_board
  local summary
  summary="$(jq -r '(reduce .votes[] as $x ({}; .[$x.by] = $x.vote)) as $last
    | "\([.participants[] | select($last[.] == "agree")] | length)/\(.participants | length) agreed"' "$f")"
  echo "$id: $from voted $vote — $st ($summary)"
  case "$st" in
    agreed)
      echo "  record it in the PR/ticket: board consensus show $id --markdown" >&2
      notify_quiet "$(jq -rn --arg id "$id" --arg ref "$(jq -r '.ref // ""' "$f")" "$JQ_LINE"'
        "[board] Consensus \($id) agreed by every participant" + (if $ref == "" then "" else " (\($ref | line))" end)')" "$id" ;;
    objected)
      echo "  parked for the owner; record it in the PR/ticket: board consensus show $id --markdown" >&2
      notify_quiet "$(jq -rn --arg id "$id" --arg by "$from" "$JQ_LINE"'
        "[board] Consensus \($id) objected by \($by | line): parked for the owner"')" "$id" ;;
  esac
  return 0
}

cons_ls() {
  local all=0
  case "${1:-}" in
    "") ;;
    --all) all=1 ;;
    *) die "consensus ls: unknown option $1" ;;
  esac
  sweep_if_back
  local rec
  if rec="$(away_record)"; then away_line "$rec"; else echo "owner is not away"; fi
  local files=("$BOARD_HOME"/consensus/c-*.json)
  [ -e "${files[0]}" ] || { echo "no consensus items"; return 0; }
  local rows
  rows="$(jq -s --argjson all "$all" --argjson now "$(now_ms)" "$JQ_DEFANG"'
    map(select(type == "object" and .id)
        | select($all == 1 or .status == "pending" or ($now - (.decided_at // .updated_at // 0)) < 86400000))
    | sort_by(.created_at) | walk(if type == "string" then defang else . end)' "${files[@]}")"
  [ "$(jq 'length' <<<"$rows")" -gt 0 ] || { echo "no consensus items (--all shows older ones)"; return 0; }
  echo
  {
    printf 'ID\tSTATUS\tFROM\tVOTES\tREF\tPROPOSAL\n'
    jq -r "$JQ_SAFE"'.[] | (reduce .votes[] as $x ({}; .[$x.by] = $x.vote)) as $last
      | [ .id, .status, .from,
          ([.participants[] | . + ":" + ($last[.] // "-")] | join(",")),
          (.ref // "-"), (.proposal | gsub("[\t\n]"; " ") | .[0:60]) ] | map(safe) | @tsv' <<<"$rows"
  } | column -t -s $'\t'
}

cons_show() {
  local id="" md=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --markdown|--md) md=1 ;;
      -*) die "consensus show: unknown option $1" ;;
      *) id="$1" ;;
    esac
    shift
  done
  [ -n "$id" ] || { sub_usage consensus show >&2; exit 2; }
  local f; f="$(cons_path "$id")"
  [ -f "$f" ] || die "no such consensus item: $id"
  sweep_if_back
  # Files may be edited by hand: what is printed never carries "[BOARD" either.
  if [ "$md" = 0 ]; then jq "$JQ_DEFANG"'walk(if type == "string" then defang else . end)' "$f"; return 0; fi
  jq -r --arg red "$(red_lines_inline)" "$JQ_TS$JQ_LINE$JQ_DEFANG"'
    def line: tostring | gsub("[\r\n\t]+"; " ") | gsub("[\u0000-\u001f\u007f-\u009f]"; "?")
      | gsub("@"; "@\u200b") | defang;   # pasted into a PR/ticket, "@name" must not ping anyone
    def cell: line | gsub("\\|"; "\\|");
    (reduce .votes[] as $x ({}; .[$x.by] = $x.vote)) as $last
    | "#### Owner-away consensus `\(.id)`: \(.status)",
      "",
      "- **Proposal:** \(.proposal | line)",
      "- **Ref:** \((.ref // "-") | line)",
      "- **Proposed by:** \(.from | line) at \(.created_at | ts) (UTC)",
      "- **Owner away:** since \(.away.since | ts) (set by \((.away.by // "-") | line))",
      "- **Participants:** \(.participants | map(line) | join(", "))",
      "",
      "| Session | Vote | At (UTC) | Note |",
      "|---|---|---|---|",
      (.votes[] | "| \(.by | cell) | \(.vote | cell) | \(.at | ts) | \((.note // "") | cell) |"),
      (.participants[] as $p | select($last[$p] == null) | "| \($p | cell) | (no vote) | - | silence is not agreement |"),
      "",
      "**Outcome:** " + (
        if .status == "agreed" then "agreed at \(.decided_at | ts): every participant agreed explicitly."
        elif .status == "objected" then "objected at \(.decided_at | ts): parked for the owner."
        elif .status == "owner_back" then "returned to the owner at \(.decided_at | ts): the owner came back before every participant agreed."
        else "pending: waiting for \([.participants[] | select($last[.] != "agree")] | join(", "))." end),
      "",
      "_Red lines never pass by consensus: \($red)._"' "$f"
}

# ---------------------------------------------------------------- doctor
cmd_doctor() {
  local bad=0
  ok() { printf '  ok    %s\n' "$*"; }
  warn() { printf '  warn  %s\n' "$*"; }
  fail() { printf '  FAIL  %s\n' "$*"; bad=1; }
  echo "dependencies:"
  local c
  for c in jq tmux python3 curl flock column; do
    if command -v "$c" >/dev/null 2>&1; then ok "$c"; else fail "$c not found"; fi
  done
  if python3 -c 'import yaml' 2>/dev/null; then ok "python3 yaml"; else fail "python3 yaml (pip install pyyaml)"; fi
  if command -v inotifywait >/dev/null 2>&1; then ok "inotifywait (fast path)"; else warn "inotifywait not installed — polling"; fi

  echo "config:"
  local cd; cd="$(config_dir)"
  if [ -f "$cd/fleet.yaml" ]; then
    if python3 -c 'import sys,yaml; yaml.safe_load(open(sys.argv[1]))' "$cd/fleet.yaml" 2>/dev/null; then
      ok "fleet.yaml ($cd)"
    else fail "fleet.yaml does not parse ($cd)"; fi
  else warn "no fleet.yaml in $cd"; fi
  if [ -n "${SLACK_WEBHOOK_URL:-}" ] || grep -q '^[[:space:]]*\(export[[:space:]]\+\)\?SLACK_WEBHOOK_URL=..' "$cd/.env" 2>/dev/null; then
    ok "SLACK_WEBHOOK_URL set"
  else warn "SLACK_WEBHOOK_URL not set — notify is a no-op"; fi
  local bu
  if bu="$(python3 "$FLEET" board-url-check 2>/dev/null)"; then
    if [ -n "$bu" ]; then ok "board URL $bu (alerts link to the board)"; else warn "no board URL (BOARD_PUBLIC_URL / board_url) — alerts carry no board link"; fi
  else fail "board URL $bu — alerts carry no board link"; fi

  echo "install:"
  local settings="${CLAUDE_SETTINGS:-$HOME/.claude/settings.json}"
  if [ -f "$settings" ] && jq -e '[.hooks // {} | .[][]?.hooks[]?.command // empty | select(test("board-hook\\.sh"))] | length > 0' "$settings" >/dev/null 2>&1; then
    local evs
    evs="$(jq -r '[.hooks | to_entries[] | select([.value[]?.hooks[]?.command // empty | select(test("board-hook\\.sh"))] | length > 0) | .key] | join(",")' "$settings")"
    ok "hook installed for: $evs"
  else fail "board-hook.sh not in $settings (run scripts/install.sh)"; fi
  if command -v board >/dev/null 2>&1; then ok "board on PATH"; else warn "board not on PATH (~/.local/bin)"; fi
  if [ -d "$BOARD_HOME" ] && [ -w "$BOARD_HOME" ]; then ok "BOARD_HOME $BOARD_HOME"; else fail "BOARD_HOME $BOARD_HOME missing or not writable"; fi
  local sd="${CLAUDE_SESSIONS_DIR:-$HOME/.claude/sessions}"
  if [ -d "$sd" ]; then ok "session registry $sd"; else fail "no session registry at $sd"; fi

  echo "runtime:"
  if [ -f "$BOARD_HOME/collect.lock" ] && ! flock -n "$BOARD_HOME/collect.lock" true 2>/dev/null; then
    ok "collector running (pid $(cat "$BOARD_HOME/collect.pid" 2>/dev/null || echo '?'))"
  else warn "collector not running (fleet-up starts it in tmux session 'switchboard')"; fi
  echo "alerting (board-notify status):"
  "$REPO/bin/board-notify" status 2>&1 | sed 's/^/  /'
  if [ -f "$BOARD_HOME/snapshot.json" ]; then
    local age=$(( ( $(now_ms) - $(jq '.generated_at // 0' "$BOARD_HOME/snapshot.json") ) / 1000 ))
    ok "snapshot.json generated ${age}s ago"
  else warn "no snapshot.json yet"; fi
  return "$bad"
}

# ---------------------------------------------------------------- main
sub="${1:-}"
[ $# -gt 0 ] && shift
case "$sub" in
  # `answer` takes free text as its second argument, so "--help" there is an answer: only a
  # leading -h/--help asks for help.
  answer)
    case "${1:-}" in -h|--help) sub_usage answer; exit 0 ;; esac ;;
  ls|snapshot|ask|decisions|mark|press|limit|notify|doctor|ack)
    if wants_help "$@"; then sub_usage "$sub"; exit 0; fi ;;
  # proposals, notes and the owner's words are free text: only -h/--help right after the
  # subcommand (or instead of it) asks for help.
  away|consensus)
    case "${1:-}" in -h|--help) sub_usage "$sub"; exit 0 ;; esac
    case "${2:-}" in -h|--help) sub_usage "$sub" "$1"; exit 0 ;; esac ;;
  task)
    if wants_help "$@"; then
      case "${1:-}" in new|stage|ls|show) sub_usage task "$1" ;; *) sub_usage task ;; esac
      exit 0
    fi ;;
esac
case "$sub" in
  ls) cmd_ls "$@" ;;
  snapshot) cmd_snapshot "$@" ;;
  ask) cmd_ask "$@" ;;
  decisions) cmd_decisions "$@" ;;
  answer) cmd_answer "$@" ;;
  mark) cmd_mark "$@" ;;
  press) cmd_press "$@" ;;
  task) cmd_task "$@" ;;
  limit) cmd_limit "$@" ;;
  notify) cmd_notify "$@" ;;
  ack) [ $# -gt 0 ] || { sub_usage ack >&2; exit 2; }; exec "$REPO/bin/board-notify" ack "$@" ;;
  doctor) cmd_doctor "$@" ;;
  away) cmd_away "$@" ;;
  consensus) cmd_consensus "$@" ;;
  -h|--help|help) usage ;;
  "") usage; exit 2 ;;
  *) echo "board: unknown command '$sub'" >&2; usage >&2; exit 2 ;;
esac
