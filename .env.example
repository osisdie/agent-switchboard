# Copy to <config dir>/.env. Leave empty to disable Slack notifications.
SLACK_WEBHOOK_URL=

# ---- alerting (bin/board-notify). Each channel is enabled only when its variables are set.
# Slack member id to @-mention on warn and above (guarantees a mobile push), e.g. <@U0123456789>
SLACK_MENTION=
# Email (port 465 = SSL, 587 = STARTTLS, other = STARTTLS when offered; SMTP_SECURITY=ssl|starttls|none overrides)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL_TO=
# LINE Messaging API push: the bot's long-lived channel access token and the target user/group id
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TO=
# AWS SNS (needs the aws cli and credentials; AWS_PROFILE / AWS_REGION may be set here too)
AWS_SNS_TOPIC_ARN=
# Generic JSON webhook (ntfy, PagerDuty Events bridge, ...); optional Authorization header value
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_AUTH=
# Desktop toast (WSL powershell.exe / notify-send / osascript); set 0 to disable
ALERT_DESKTOP=1
